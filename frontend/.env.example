# Copy to .env.local (never commit it). Values from Supabase dashboard > Project Settings > API.
# Only the PUBLISHABLE key (sb_publishable_...) goes here - NEVER the service_role / secret key.
# Row Level Security in the database is what protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
